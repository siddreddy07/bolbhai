// use prisma-8

enum ShopType {
  GROCERY
  CAFE
}

// Is the bill settled, or written in the ledger (khata) to be paid later?
enum PaymentStatus {
  PAID
  LEDGER
}

// How it was paid.
enum PaymentType {
  CASH
  UPI
}

model users {
  id        Uuid               @id @onCreate(uuid())
  email     String             @unique
  password  String
  name      String?
  shops     shops[]
  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt
}

model shops {
  id        Uuid               @id @onCreate(uuid())
  name      String?
  type      ShopType
  gstin     String             @unique
  owner     users              @relation(fields: [ownerId], references: [id])
  ownerId   Uuid
  inventory shop_inventory[]
  invoices  invoices[]
  transactions customer_transactions[]
  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt
}

// What one shop sells: a catalog product (productId) or its own item (customName), with the shop's price and stock.
model shop_inventory {
  id           Uuid               @id @onCreate(uuid())
  shop         shops              @relation(fields: [shopId], references: [id])
  shopId       Uuid
  product      products?          @relation(fields: [productId], references: [id])
  productId    Uuid?
  // For products that are not in the shared catalog
  customName   String?
  // Shop-specific values
  sellingPrice Decimal
  stock        Decimal            @default(0)
  unit         String?
  createdAt    DateTime           @default(now()) @onCreate(now())
  updatedAt    temporal.UpdatedAt

  @@unique([shopId, productId])
}

// Shared product catalog (barcode, name, pack size). Shops add their own price and stock elsewhere.
model products {
  id          Uuid               @id @onCreate(uuid())
  barcode     String             @unique
  name        String
  brand       String?
  quantity    Decimal?
  unit        String?
  category    String?
  subcategory String?
  // Rough shelf price in whole rupees, in steps of 100. Filled by `npm run db:price`.
  currency    String             @default("INR")
  cost        Int?
  inventory   shop_inventory[]
  createdAt   DateTime           @default(now()) @onCreate(now())
  updatedAt   temporal.UpdatedAt
}

// A bill a shop made. `items` is a list of { pid, quantity }: pid = the product's id in the products table.
model invoices {
  id            Uuid     @id @onCreate(uuid())
  shop          shops    @relation(fields: [shopId], references: [id])
  shopId        Uuid
  // when the bill was made
  date          DateTime @default(now()) @onCreate(now())
  items         Json
  payment       PaymentStatus @default(PAID)
  paymentType   PaymentType   @default(CASH)
  transactions  customer_transactions[]

  // the bills lists and the analytics always ask for one shop's bills by date
  @@index([shopId, date])
}


// One money record per sale to a customer: which shop, which customer (if known), which bill, and how much.
// `id` and `invoiceId` together are one key (a record is found, and kept unique, by the pair).
model customer_transactions {
  id            Uuid               @id @onCreate(uuid())
  shop          shops              @relation(fields: [shopId], references: [id])
  shopId        Uuid
  customerId    Uuid?
  invoice       invoices           @relation(fields: [invoiceId], references: [id])
  invoiceId     Uuid

  subtotal      Decimal
  paymentStatus String
  status        String

  createdAt     DateTime           @default(now()) @onCreate(now())
  updatedAt     temporal.UpdatedAt

  @@unique([id, invoiceId])
}
